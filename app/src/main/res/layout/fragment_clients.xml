<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/funky_background"
    android:orientation="vertical"
    android:paddingTop="12dp"
    tools:context=".fragments.ClientsFragment">

    <ImageView
        android:id="@+id/imageFunkyHeader"
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:layout_marginHorizontal="16dp"
        android:layout_marginBottom="4dp"
        android:contentDescription="@string/brand_logo"
        android:scaleType="centerCrop" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="16dp"
        android:paddingVertical="8dp">
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="@string/user_name"
                android:textColor="@color/funky_text"
                android:textSize="16sp"
                android:textStyle="bold" />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:letterSpacing="0.12"
                android:text="@string/user_role"
                android:textColor="@color/funky_text_secondary"
                android:textSize="12sp"
                android:textStyle="bold" />
        </LinearLayout>
        <ImageButton android:id="@+id/buttonCashbox" style="@style/HeaderIconButton" android:contentDescription="@string/cashbox" android:src="@drawable/ic_cashbox" />
        <ImageButton android:id="@+id/buttonUsers" style="@style/HeaderIconButton" android:contentDescription="@string/team_users" android:src="@drawable/ic_users" />
        <ImageButton android:id="@+id/buttonAdmin" style="@style/HeaderIconButton" android:contentDescription="@string/user_management" android:src="@drawable/ic_admin" />
        <ImageButton android:id="@+id/buttonLogout" style="@style/HeaderIconButton" android:contentDescription="@string/logout" android:src="@drawable/ic_logout" />
    </LinearLayout>

    <LinearLayout android:layout_width="match_parent" android:layout_height="104dp"
        android:layout_marginHorizontal="14dp" android:layout_marginTop="8dp" android:orientation="horizontal">
        <com.google.android.material.card.MaterialCardView android:layout_width="0dp" android:layout_height="match_parent"
            android:layout_weight="1" app:cardBackgroundColor="@color/funky_surface" app:cardCornerRadius="16dp"
            app:cardElevation="1dp" app:strokeColor="@color/funky_border" app:strokeWidth="1dp">
            <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent" android:gravity="center_vertical"
                android:orientation="vertical" android:paddingHorizontal="14dp" android:paddingVertical="11dp">
                <TextView android:id="@+id/textInvoicedLabel" android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:textColor="@color/funky_text_secondary" android:textSize="11sp" android:textStyle="bold" tools:text="↗  TOTAL INVOICED · 2026" />
                <TextView android:id="@+id/textInvoicedValue" android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:layout_marginTop="5dp" android:ellipsize="end" android:maxLines="1" android:textColor="@color/funky_text"
                    android:textSize="22sp" android:textStyle="bold" tools:text="20.100,00 EUR" />
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="3dp"
                    android:text="@string/all_event_budgets" android:textColor="@color/funky_text_secondary" android:textSize="11sp" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>
        <com.google.android.material.card.MaterialCardView android:layout_width="0dp" android:layout_height="match_parent"
            android:layout_marginStart="9dp" android:layout_weight="1" app:cardBackgroundColor="@color/funky_surface"
            app:cardCornerRadius="16dp" app:cardElevation="1dp" app:strokeColor="@color/funky_border" app:strokeWidth="1dp">
            <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent" android:gravity="center_vertical"
                android:orientation="vertical" android:paddingHorizontal="14dp" android:paddingVertical="11dp">
                <TextView android:id="@+id/textActualLabel" android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:textColor="@color/funky_text_secondary" android:textSize="11sp" android:textStyle="bold" tools:text="↗  ACTUAL · 2026" />
                <TextView android:id="@+id/textActualValue" android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:layout_marginTop="5dp" android:ellipsize="end" android:maxLines="1" android:textColor="@color/funky_mint"
                    android:textSize="22sp" android:textStyle="bold" tools:text="5.900,00 EUR" />
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="3dp"
                    android:text="@string/actual_profit_formula" android:textColor="@color/funky_text_secondary" android:textSize="11sp" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:orientation="horizontal"
        android:paddingHorizontal="26dp"
        android:paddingVertical="4dp">
        <com.google.android.material.button.MaterialButton
            android:id="@+id/buttonEvents"
            style="@style/MainNavButton"
            android:layout_weight="1"
            android:alpha="0.68"
            android:backgroundTint="@color/funky_green"
            android:text="@string/events" />
        <com.google.android.material.button.MaterialButton
            android:id="@+id/buttonClients"
            style="@style/MainNavButton"
            android:layout_marginStart="7dp"
            android:layout_weight="1"
            android:backgroundTint="@color/funky_pink"
            android:text="@string/clients" />
        <com.google.android.material.button.MaterialButton
            android:id="@+id/buttonTeam"
            style="@style/MainNavButton"
            android:layout_marginStart="7dp"
            android:layout_weight="1"
            android:alpha="0.82"
            android:backgroundTint="@color/funky_purple"
            android:text="@string/team" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="54dp"
        android:layout_marginTop="8dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="16dp">
        <TextView
            android:id="@+id/textClientsTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textColor="@color/funky_text_secondary"
            android:textSize="17sp"
            android:textStyle="bold"
            tools:text="Clients (4)" />
        <com.google.android.material.button.MaterialButton
            android:id="@+id/buttonAddClient"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="wrap_content"
            android:layout_height="38dp"
            android:minWidth="0dp"
            android:paddingHorizontal="12dp"
            android:text="@string/add_client"
            android:textAllCaps="false"
            android:textColor="@color/funky_text"
            android:textSize="13sp" />
    </LinearLayout>

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recyclerClients"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:paddingHorizontal="14dp"
        android:paddingTop="4dp"
        android:paddingBottom="20dp"
        tools:listitem="@layout/item_client" />
</LinearLayout>
