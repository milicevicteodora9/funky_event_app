<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/funky_background"
    android:orientation="vertical"
    android:paddingTop="12dp"
    tools:context=".fragments.ClientsFragment">

    <ImageView
        android:id="@+id/imageFunkyHeader"
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:layout_marginHorizontal="16dp"
        android:layout_marginBottom="4dp"
        android:contentDescription="@string/brand_logo"
        android:scaleType="centerCrop" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="16dp"
        android:paddingVertical="8dp">
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="@string/user_name"
                android:textColor="@color/funky_text"
                android:textSize="16sp"
                android:textStyle="bold" />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:letterSpacing="0.12"
                android:text="@string/user_role"
                android:textColor="@color/funky_text_secondary"
                android:textSize="12sp"
                android:textStyle="bold" />
        </LinearLayout>
        <ImageButton android:id="@+id/buttonCashbox" style="@style/HeaderIconButton" android:contentDescription="@string/cashbox" android:src="@drawable/ic_cashbox" />
        <ImageButton android:id="@+id/buttonUsers" style="@style/HeaderIconButton" android:contentDescription="@string/team_users" android:src="@drawable/ic_users" />
        <ImageButton android:id="@+id/buttonAdmin" style="@style/HeaderIconButton" android:contentDescription="@string/user_management" android:src="@drawable/ic_admin" />
        <ImageButton android:id="@+id/buttonLogout" style="@style/HeaderIconButton" android:contentDescription="@string/logout" android:src="@drawable/ic_logout" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:orientation="horizontal"
        android:paddingHorizontal="26dp"
        android:paddingVertical="4dp">
        <com.google.android.material.button.MaterialButton
            android:id="@+id/buttonEvents"
            style="@style/MainNavButton"
            android:layout_weight="1"
            android:alpha="0.68"
            android:backgroundTint="@color/funky_green"
            android:text="@string/events" />
        <com.google.android.material.button.MaterialButton
            android:id="@+id/buttonClients"
            style="@style/MainNavButton"
            android:layout_marginStart="7dp"
            android:layout_weight="1"
            android:backgroundTint="@color/funky_pink"
            android:text="@string/clients" />
        <com.google.android.material.button.MaterialButton
            android:id="@+id/buttonTeam"
            style="@style/MainNavButton"
            android:layout_marginStart="7dp"
            android:layout_weight="1"
            android:alpha="0.82"
            android:backgroundTint="@color/funky_purple"
            android:text="@string/team" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="54dp"
        android:layout_marginTop="8dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="16dp">
        <TextView
            android:id="@+id/textClientsTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textColor="@color/funky_text_secondary"
            android:textSize="17sp"
            android:textStyle="bold"
            tools:text="Clients (4)" />
        <com.google.android.material.button.MaterialButton
            android:id="@+id/buttonAddClient"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="wrap_content"
            android:layout_height="38dp"
            android:minWidth="0dp"
            android:paddingHorizontal="12dp"
            android:text="@string/add_client"
            android:textAllCaps="false"
            android:textColor="@color/funky_text"
            android:textSize="13sp" />
    </LinearLayout>

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recyclerClients"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:paddingHorizontal="14dp"
        android:paddingTop="4dp"
        android:paddingBottom="20dp"
        tools:listitem="@layout/item_client" />
</LinearLayout>
