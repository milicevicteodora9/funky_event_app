<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent" android:layout_height="wrap_content" android:fillViewport="true">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:paddingHorizontal="18dp" android:paddingBottom="14dp">
        <TextView android:id="@+id/textCashboxEntryDialogTitle" android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center"
            android:paddingTop="8dp" android:paddingBottom="14dp" android:text="@string/add_cashbox_entry" android:textColor="@color/funky_text" android:textSize="21sp" android:textStyle="bold" />
        <LinearLayout android:layout_width="match_parent" android:layout_height="76dp" android:orientation="horizontal">
            <com.google.android.material.button.MaterialButton android:id="@+id/buttonEntryReceived" style="@style/CashboxTypeButton"
                android:layout_weight="1" android:backgroundTint="@color/funky_completed" app:strokeColor="@color/funky_mint" app:strokeWidth="1dp" android:text="↗\nReceived" />
            <com.google.android.material.button.MaterialButton android:id="@+id/buttonEntrySpent" style="@style/CashboxTypeButton"
                android:layout_marginStart="8dp" android:layout_weight="1" android:text="↘\nSpent" />
        </LinearLayout>
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:orientation="horizontal">
            <com.google.android.material.textfield.TextInputLayout style="@style/CashboxInput" android:layout_width="0dp" android:layout_weight="1" android:hint="@string/exchange_rate">
                <com.google.android.material.textfield.TextInputEditText android:id="@+id/inputEntryExchangeRate" android:layout_width="match_parent" android:layout_height="wrap_content" android:inputType="numberDecimal" android:maxLines="1" android:textSize="14sp" />
            </com.google.android.material.textfield.TextInputLayout>
            <com.google.android.material.textfield.TextInputLayout style="@style/CashboxInput" android:layout_width="0dp" android:layout_marginStart="8dp" android:layout_weight="1" android:hint="@string/eur_amount">
                <com.google.android.material.textfield.TextInputEditText android:id="@+id/inputEntryEurAmount" android:layout_width="match_parent" android:layout_height="wrap_content" android:inputType="numberDecimal" android:maxLines="1" android:textSize="14sp" />
            </com.google.android.material.textfield.TextInputLayout>
        </LinearLayout>
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:orientation="horizontal">
            <com.google.android.material.textfield.TextInputLayout style="@style/CashboxInput" android:layout_width="0dp" android:layout_weight="1" android:hint="@string/amount">
                <com.google.android.material.textfield.TextInputEditText android:id="@+id/inputEntryAmount" android:layout_width="match_parent" android:layout_height="wrap_content" android:inputType="numberDecimal" android:maxLines="1" android:textSize="15sp" />
            </com.google.android.material.textfield.TextInputLayout>
            <com.google.android.material.textfield.TextInputLayout style="@style/CashboxInput" android:layout_width="120dp" android:layout_height="58dp" android:layout_marginStart="8dp" android:hint="@string/currency" app:endIconMode="dropdown_menu">
                <AutoCompleteTextView android:id="@+id/inputEntryCurrency" android:layout_width="match_parent" android:layout_height="match_parent" android:clickable="true" android:cursorVisible="false" android:focusable="false" android:inputType="none" android:paddingTop="4dp" android:textSize="15sp" />
            </com.google.android.material.textfield.TextInputLayout>
        </LinearLayout>
        <com.google.android.material.textfield.TextInputLayout style="@style/CashboxInput" android:layout_marginTop="8dp" android:hint="@string/date">
            <com.google.android.material.textfield.TextInputEditText android:id="@+id/inputEntryDate" android:layout_width="match_parent" android:layout_height="wrap_content" android:focusable="false" android:inputType="none" android:textSize="15sp" />
        </com.google.android.material.textfield.TextInputLayout>
        <com.google.android.material.textfield.TextInputLayout style="@style/CashboxInput" android:layout_marginTop="8dp" android:hint="@string/description">
            <com.google.android.material.textfield.TextInputEditText android:id="@+id/inputEntryDescription" android:layout_width="match_parent" android:layout_height="70dp" android:gravity="top" android:inputType="textMultiLine" android:paddingTop="12dp" android:textSize="15sp" />
        </com.google.android.material.textfield.TextInputLayout>
        <com.google.android.material.textfield.TextInputLayout style="@style/CashboxInput" android:layout_height="62dp" android:layout_marginTop="10dp" android:hint="@string/link_to_event" app:endIconMode="dropdown_menu">
            <AutoCompleteTextView android:id="@+id/inputEntryEvent" android:layout_width="match_parent" android:layout_height="match_parent" android:clickable="true" android:cursorVisible="false" android:focusable="false" android:inputType="none" android:textSize="15sp" />
        </com.google.android.material.textfield.TextInputLayout>
        <com.google.android.material.button.MaterialButton android:id="@+id/buttonSaveCashboxEntry" android:layout_width="match_parent" android:layout_height="48dp"
            android:layout_marginTop="14dp" android:backgroundTint="@color/funky_mint" android:text="@string/save" android:textAllCaps="false" android:textColor="@color/white" android:textSize="15sp" android:textStyle="bold" app:cornerRadius="14dp" />
    </LinearLayout>
</ScrollView>
