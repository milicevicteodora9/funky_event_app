<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent" android:layout_height="wrap_content"
    android:layout_marginBottom="8dp" android:clickable="true" android:focusable="true"
    android:foreground="?attr/selectableItemBackground" app:cardBackgroundColor="@color/funky_surface"
    app:cardCornerRadius="12dp" app:cardElevation="0dp" app:strokeColor="@color/funky_border" app:strokeWidth="1dp">
    <LinearLayout android:layout_width="match_parent" android:layout_height="76dp"
        android:gravity="center_vertical" android:orientation="horizontal" android:paddingHorizontal="14dp">
        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
            <TextView android:id="@+id/textTeamMemberName" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:ellipsize="end" android:maxLines="1" android:textColor="@color/funky_text" android:textSize="16sp" android:textStyle="bold" tools:text="Aleksandar Lazić" />
            <TextView android:id="@+id/textTeamMemberContact" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="5dp" android:ellipsize="end" android:maxLines="1" android:textColor="@color/funky_text_secondary" android:textSize="12sp" tools:text="☎ +381 63 223960    ◉ Beograd" />
        </LinearLayout>
        <TextView android:id="@+id/textTeamMemberDebt" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:layout_marginStart="8dp" android:textColor="@color/funky_expense" android:textSize="13sp" android:textStyle="bold" tools:text="1.600,00 €" />
        <ImageButton android:id="@+id/buttonEditTeamMember" android:layout_width="38dp" android:layout_height="38dp"
            android:layout_marginStart="4dp" android:background="?attr/selectableItemBackgroundBorderless" android:contentDescription="@string/edit"
            android:padding="9dp" android:src="@drawable/ic_edit" app:tint="@color/funky_text_secondary" />
        <ImageView android:layout_width="18dp" android:layout_height="18dp" android:contentDescription="@null" android:src="@drawable/ic_chevron_right" />
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
