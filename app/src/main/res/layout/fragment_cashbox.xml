<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools" android:layout_width="match_parent" android:layout_height="match_parent"
    android:background="@color/funky_background" android:orientation="vertical" tools:context=".fragments.CashboxFragment">
    <LinearLayout android:layout_width="match_parent" android:layout_height="62dp" android:gravity="center_vertical" android:paddingHorizontal="12dp">
        <ImageButton android:id="@+id/buttonCashboxBack" style="@style/HeaderIconButton" android:contentDescription="@string/back" android:src="@drawable/ic_back" />
        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginStart="8dp" android:layout_weight="1" android:orientation="vertical">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/my_cashbox" android:textColor="@color/funky_text" android:textSize="19sp" android:textStyle="bold" />
            <TextView android:id="@+id/textCashboxOwner" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="@color/funky_text_secondary" android:textSize="12sp" tools:text="Teodora Milićević · Balance in EUR" />
        </LinearLayout>
    </LinearLayout>
    <View android:layout_width="match_parent" android:layout_height="1dp" android:background="@color/funky_border" />
    <LinearLayout android:layout_width="match_parent" android:layout_height="94dp" android:layout_marginHorizontal="12dp" android:layout_marginTop="10dp" android:orientation="horizontal">
        <TextView android:id="@+id/textCashboxReceived" style="@style/CashboxSummary" tools:text="RECEIVED\n170,65 EUR" />
        <TextView android:id="@+id/textCashboxSpent" style="@style/CashboxSummary" android:layout_marginStart="7dp" tools:text="SPENT\n259,01 EUR" />
        <TextView android:id="@+id/textCashboxBalance" style="@style/CashboxSummary" android:layout_marginStart="7dp" android:textColor="@color/funky_mint" app:strokeColor="@color/funky_mint" tools:text="BALANCE\n-88,36 EUR" />
    </LinearLayout>
    <LinearLayout android:layout_width="match_parent" android:layout_height="42dp" android:layout_marginHorizontal="12dp" android:layout_marginTop="9dp" android:orientation="horizontal">
        <com.google.android.material.button.MaterialButton android:id="@+id/buttonCashboxAdd" style="@style/CashboxAction" android:layout_weight="1" android:backgroundTint="@color/funky_mint" android:text="@string/add_entry" android:textColor="@color/white" />
        <com.google.android.material.button.MaterialButton android:id="@+id/buttonCashboxPdf" style="@style/CashboxAction" android:layout_marginStart="8dp" android:layout_weight="1" android:text="@string/pdf_receipt" />
    </LinearLayout>
    <LinearLayout android:layout_width="match_parent" android:layout_height="42dp" android:layout_marginHorizontal="12dp" android:layout_marginTop="7dp" android:orientation="horizontal">
        <com.google.android.material.button.MaterialButton android:id="@+id/buttonCashboxCamera" style="@style/CashboxAction" android:layout_weight="1" android:text="@string/take_photo" />
        <com.google.android.material.button.MaterialButton android:id="@+id/buttonCashboxGallery" style="@style/CashboxAction" android:layout_marginStart="8dp" android:layout_weight="1" android:text="@string/from_gallery" />
    </LinearLayout>
    <TextView android:id="@+id/textCashboxEntriesTitle" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginHorizontal="14dp" android:layout_marginTop="12dp" android:textColor="@color/funky_text_secondary" android:textSize="15sp" android:textStyle="bold" tools:text="All entries (6)" />
    <androidx.recyclerview.widget.RecyclerView android:id="@+id/recyclerCashbox" android:layout_width="match_parent" android:layout_height="0dp"
        android:layout_weight="1" android:clipToPadding="false" android:paddingHorizontal="12dp" android:paddingTop="8dp" android:paddingBottom="10dp" tools:listitem="@layout/item_cashbox_transaction" />
    <TextView android:layout_width="match_parent" android:layout_height="34dp" android:gravity="center" android:text="@string/exchange_reference"
        android:textColor="@color/funky_text_secondary" android:textSize="11sp" />
</LinearLayout>
