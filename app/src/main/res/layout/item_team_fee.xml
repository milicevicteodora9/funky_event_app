<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="7dp" android:background="@color/funky_badge" android:gravity="center_vertical" android:minHeight="76dp" android:orientation="horizontal" android:paddingHorizontal="12dp" android:paddingVertical="8dp">
    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
        <TextView android:id="@+id/textFeeAmount" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="@color/funky_text" android:textSize="15sp" android:textStyle="bold" tools:text="800,00 €" />
        <TextView android:id="@+id/textFeeEvent" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="3dp" android:ellipsize="end" android:maxLines="1" android:textColor="@color/funky_text_secondary" android:textSize="12sp" tools:text="BEO Shopping Center aktivacija · Moderator oba dana" />
        <TextView android:id="@+id/textFeeDate" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="2dp" android:textColor="@color/funky_text_secondary" android:textSize="11sp" tools:text="24 Aug 2026" />
    </LinearLayout>
    <ImageButton android:id="@+id/buttonEditFee" style="@style/TeamSmallAction" android:contentDescription="@string/edit" android:src="@drawable/ic_edit" app:tint="@color/funky_text_secondary" />
    <ImageButton android:id="@+id/buttonDeleteFee" style="@style/TeamSmallAction" android:contentDescription="@string/delete" android:src="@drawable/ic_delete" app:tint="@color/funky_text_secondary" />
</LinearLayout>
