<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme. -->
    <style name="Base.Theme.FunkyEventApp" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="colorPrimary">@color/funky_mint</item>
        <item name="android:fontFamily">sans</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:statusBarColor">@color/funky_background</item>
        <item name="android:navigationBarColor">@color/funky_background</item>
        <item name="android:windowBackground">@color/funky_background</item>
    </style>

    <style name="Theme.FunkyEventApp" parent="Base.Theme.FunkyEventApp" />

    <style name="HeaderIconButton">
        <item name="android:layout_width">36dp</item>
        <item name="android:layout_height">36dp</item>
        <item name="android:background">?attr/selectableItemBackgroundBorderless</item>
        <item name="android:padding">8dp</item>
    </style>

    <style name="MainNavButton" parent="Widget.Material3.Button">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">38dp</item>
        <item name="android:textColor">@color/white</item>
        <item name="android:textSize">11sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:letterSpacing">0.08</item>
        <item name="cornerRadius">15dp</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
    </style>

    <style name="EventFilterButton" parent="Widget.Material3.Button.TextButton">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">match_parent</item>
        <item name="android:backgroundTint">@color/funky_surface</item>
        <item name="android:textColor">@color/funky_text_secondary</item>
        <item name="android:textSize">15sp</item>
        <item name="android:textStyle">bold</item>
        <item name="cornerRadius">0dp</item>
        <item name="strokeWidth">0dp</item>
    </style>

    <style name="BudgetSummaryValue">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:gravity">center</item>
        <item name="android:textColor">@color/funky_text</item>
        <item name="android:textSize">12sp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="BudgetProfitValue" parent="BudgetSummaryValue">
        <item name="android:textColor">@color/funky_completed_text</item>
        <item name="android:textSize">11sp</item>
    </style>

    <style name="BudgetTabButton" parent="Widget.Material3.Button.TextButton">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">38dp</item>
        <item name="android:backgroundTint">@color/funky_badge</item>
        <item name="android:textColor">@color/funky_text_secondary</item>
        <item name="android:textSize">12sp</item>
        <item name="android:textStyle">bold</item>
        <item name="cornerRadius">12dp</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
    </style>

    <style name="ClientSummaryValue">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">40dp</item>
        <item name="android:layout_weight">1</item>
        <item name="android:layout_marginHorizontal">3dp</item>
        <item name="android:gravity">center</item>
        <item name="android:padding">2dp</item>
        <item name="android:textColor">@color/funky_text</item>
        <item name="android:textSize">9sp</item>
        <item name="android:textStyle">bold</item>
    </style>
    <style name="CashboxSummary" parent="Widget.Material3.CardView.Filled">
        <item name="android:layout_width">0dp</item><item name="android:layout_height">match_parent</item><item name="android:layout_weight">1</item>
        <item name="android:background">@drawable/bg_logo_placeholder</item><item name="android:gravity">center</item>
        <item name="android:padding">6dp</item><item name="android:textColor">@color/funky_text</item><item name="android:textSize">11sp</item><item name="android:textStyle">bold</item>
        <item name="android:fontFamily">sans-serif-medium</item><item name="android:letterSpacing">0.025</item>
    </style>
    <style name="CashboxAction" parent="Widget.Material3.Button.OutlinedButton">
        <item name="android:layout_width">0dp</item><item name="android:layout_height">match_parent</item><item name="android:textAllCaps">false</item>
        <item name="android:textColor">@color/funky_text</item><item name="android:textSize">13sp</item><item name="cornerRadius">13dp</item>
        <item name="android:insetTop">0dp</item><item name="android:insetBottom">0dp</item>
    </style>
    <style name="CashboxTypeButton" parent="Widget.Material3.Button.OutlinedButton">
        <item name="android:layout_width">0dp</item><item name="android:layout_height">match_parent</item><item name="android:textAllCaps">false</item>
        <item name="android:textColor">@color/funky_text</item><item name="android:textSize">15sp</item><item name="cornerRadius">14dp</item>
        <item name="android:insetTop">0dp</item><item name="android:insetBottom">0dp</item><item name="strokeColor">@color/funky_border</item>
    </style>
    <style name="CashboxInput" parent="Widget.Material3.TextInputLayout.OutlinedBox.Dense">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="boxCornerRadiusTopStart">13dp</item><item name="boxCornerRadiusTopEnd">13dp</item>
        <item name="boxCornerRadiusBottomStart">13dp</item><item name="boxCornerRadiusBottomEnd">13dp</item>
        <item name="boxStrokeColor">@color/funky_border</item><item name="hintTextColor">@color/funky_text_secondary</item>
    </style>
    <style name="NewEventInput" parent="Widget.Material3.TextInputLayout.OutlinedBox.Dense">
        <item name="android:layout_width">match_parent</item><item name="android:layout_height">wrap_content</item>
        <item name="boxCornerRadiusTopStart">18dp</item><item name="boxCornerRadiusTopEnd">18dp</item>
        <item name="boxCornerRadiusBottomStart">18dp</item><item name="boxCornerRadiusBottomEnd">18dp</item>
        <item name="boxStrokeColor">@color/funky_border</item><item name="boxBackgroundColor">@color/funky_surface</item>
        <item name="hintTextColor">@color/funky_text_secondary</item>
    </style>
    <style name="NewEventTypeButton" parent="Widget.Material3.Button.OutlinedButton">
        <item name="android:layout_width">0dp</item><item name="android:layout_height">match_parent</item>
        <item name="android:textAllCaps">false</item><item name="android:textSize">13sp</item>
        <item name="android:textColor">@color/funky_text</item><item name="android:gravity">center</item>
        <item name="cornerRadius">20dp</item><item name="strokeColor">@color/funky_border</item>
        <item name="android:insetTop">0dp</item><item name="android:insetBottom">0dp</item>
    </style>
</resources>
