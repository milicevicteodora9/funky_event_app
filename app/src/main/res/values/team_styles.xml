<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="TeamContactRow">
        <item name="android:layout_width">match_parent</item><item name="android:layout_height">44dp</item><item name="android:gravity">center_vertical</item>
        <item name="android:ellipsize">end</item><item name="android:maxLines">1</item><item name="android:textColor">@color/funky_text_secondary</item><item name="android:textSize">13sp</item>
    </style>
    <style name="TeamContactDivider"><item name="android:layout_width">match_parent</item><item name="android:layout_height">1dp</item><item name="android:background">@color/funky_border</item></style>
    <style name="TeamSummaryColumn"><item name="android:layout_width">0dp</item><item name="android:layout_height">wrap_content</item><item name="android:layout_weight">1</item><item name="android:gravity">center</item><item name="android:orientation">vertical</item></style>
    <style name="TeamSummaryLabel"><item name="android:layout_width">wrap_content</item><item name="android:layout_height">wrap_content</item><item name="android:textColor">@color/funky_text_secondary</item><item name="android:textSize">11sp</item></style>
    <style name="TeamSummaryValue"><item name="android:layout_width">wrap_content</item><item name="android:layout_height">wrap_content</item><item name="android:layout_marginTop">5dp</item><item name="android:textColor">@color/funky_text</item><item name="android:textSize">16sp</item><item name="android:textStyle">bold</item></style>
    <style name="TeamSmallAction"><item name="android:layout_width">34dp</item><item name="android:layout_height">34dp</item><item name="android:background">?attr/selectableItemBackgroundBorderless</item><item name="android:padding">9dp</item></style>
    <style name="TeamDialogLabel"><item name="android:layout_width">match_parent</item><item name="android:layout_height">wrap_content</item><item name="android:textColor">@color/funky_text_secondary</item><item name="android:textSize">12sp</item></style>
    <style name="TeamDialogSpinner"><item name="android:layout_width">match_parent</item><item name="android:layout_height">48dp</item><item name="android:background">@drawable/bg_logo_placeholder</item></style>
</resources>
